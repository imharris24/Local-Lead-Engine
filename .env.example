# Local Lead Engine Configuration
# Copy to .env and modify as needed

# Browser mode: true for headless, false for visible
HEADLESS=false

# Database path
DATABASE_PATH=data/database/leads.db

# Export path
EXPORT_PATH=data/exports

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Default search settings
DEFAULT_LIMIT=100
RETRY_ATTEMPTS=3
RETRY_DELAY=2
RETRY_BACKOFF=2